{
  "name": "@imvu/monorepo",
  "version": "0.1.0",
  "author": "David Katz",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "build": "tsc --build",
    "lint": "tsc --build",
    "build:cjs": "tsc --build",
    "build:esm": "npm run -ws build:esm",
    "docs:build": "docker build -t imvu/docs ./docs/",
    "docs:serve": "docker run --rm -it -p 8000:8000 -v %cd%:/docs imvu/docs",
    "test": "jest --coverage --verbose --ci"
  },
  "files": [
    "packages",
    "tsconfig.json",
    "tsconfig.base.json",
    "jest.config.json"
  ],
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.1",
    "@types/node": "^20.2.3",
    "@typescript-eslint/eslint-plugin": "^5.59.7",
    "@typescript-eslint/parser": "^5.59.7",
    "eslint": "^8.41.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-import-resolver-node": "^0.3.7",
    "eslint-import-resolver-typescript": "^3.5.5",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.5.0",
    "lerna": "^6.6.2",
    "prettier": "^2.8.8",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "type-fest": "^3.11.0",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "axios": "^1.1.3",
    "axios-cookiejar-support": "^4.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.0.3",
    "express": "^5.2.1",
    "reflect-metadata": "^0.1.13",
    "tough-cookie": "^4.1.3",
    "tough-cookie-file-store": "^2.0.3",
    "typescript-json-serializer": "^5.1.0"
  }
}
